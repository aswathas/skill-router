{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}\"; exec sh \"$p/scripts/learning-hook.sh\" UserPromptSubmit'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/learning-hook.ps1\" -Event UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "skill|Skill|edit|Edit|write|Write|notebook_edit|NotebookEdit|bash|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}\"; exec sh \"$p/scripts/learning-hook.sh\" PostToolUse'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/learning-hook.ps1\" -Event PostToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}